// Week 0 resources: monitoring, identities, registry, Container Apps, portal.
targetScope = 'resourceGroup'

param location string
param environmentName string
param suffix string
param tags object
param githubRepository string
param portalExists bool

var token = take(uniqueString(subscription().id, resourceGroup().id), 6)
var placeholderImage = 'mcr.microsoft.com/k8se/quickstart:latest'

var roles = {
  acrPull: '7f951dda-4ed3-4680-a7ca-43fe172d538d'
  contributor: 'b24988ac-6180-42a0-ab88-20f7382dd24c'
}

// ---------- Monitoring ----------
module logs 'br/public:avm/res/operational-insights/workspace:0.16.1' = {
  name: 'logs'
  params: {
    name: 'log-${suffix}'
    location: location
    tags: tags
    skuName: 'PerGB2018'
    dataRetention: 30            // module default is 365
    dailyQuotaGb: '0.5'          // hard daily cap against runaway ingestion
    features: {
      disableLocalAuth: true     // Entra ID only
    }
    enableTelemetry: false
  }
}

module appInsights 'br/public:avm/res/insights/component:0.8.0' = {
  name: 'appInsights'
  params: {
    name: 'appi-${suffix}'
    location: location
    tags: tags
    workspaceResourceId: logs.outputs.resourceId
    disableLocalAuth: true       // Entra ID only
    enableTelemetry: false
  }
}

// ---------- Identities ----------
// Runtime identity of the portal: pulls images from the registry, no passwords.
module portalIdentity 'br/public:avm/res/managed-identity/user-assigned-identity:0.6.0' = {
  name: 'portalIdentity'
  params: {
    name: 'id-portal-${suffix}'
    location: location
    tags: tags
    enableTelemetry: false
  }
}

// Deployment identity for GitHub Actions (OIDC, ADR-12).
// Trusts only the GitHub environment with the same name, and can change only this resource group.
// It cannot change policies or role assignments: the pipeline cannot weaken its own guardrails.
module deployIdentity 'br/public:avm/res/managed-identity/user-assigned-identity:0.6.0' = {
  name: 'deployIdentity'
  params: {
    name: 'id-deploy-${suffix}'
    location: location
    tags: tags
    federatedIdentityCredentials: [
      {
        name: 'github-${environmentName}'
        issuer: 'https://token.actions.githubusercontent.com'
        subject: 'repo:${githubRepository}:environment:${environmentName}'
        audiences: ['api://AzureADTokenExchange']
      }
    ]
    enableTelemetry: false
  }
}

resource deployContributor 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(resourceGroup().id, 'id-deploy', roles.contributor)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.contributor)
    principalId: deployIdentity.outputs.principalId
    principalType: 'ServicePrincipal'
  }
}

// ---------- Container registry ----------
module registry 'br/public:avm/res/container-registry/registry:0.13.1' = {
  name: 'registry'
  params: {
    name: replace('cr${suffix}${token}', '-', '')
    location: location
    tags: tags
    acrSku: 'Basic'              // module default is Premium
    acrAdminUserEnabled: false   // no registry passwords
    anonymousPullEnabled: false
    publicNetworkAccess: 'Enabled'
    autoGeneratedDomainNameLabelScope: 'ResourceGroupReuse' // portal default is Unsecure: a deleted name could be reclaimed by anyone (subdomain takeover)
    roleAssignments: [
      {
        roleDefinitionIdOrName: roles.acrPull
        principalId: portalIdentity.outputs.principalId
        principalType: 'ServicePrincipal'
      }
    ]
    enableTelemetry: false
  }
}

// ---------- Container Apps ----------
module containerEnv 'br/public:avm/res/app/managed-environment:0.16.0' = {
  name: 'containerEnv'
  params: {
    name: 'cae-${suffix}'
    location: location
    tags: tags
    publicNetworkAccess: 'Enabled'   // module default is Disabled
    zoneRedundant: false             // module default is true (needs a VNet)
    appLogsConfiguration: {
      destination: 'azure-monitor'   // Entra-based, works with key auth disabled on the workspace
    }
    diagnosticSettings: [
      {
        workspaceResourceId: logs.outputs.resourceId
        logCategoriesAndGroups: [{ categoryGroup: 'allLogs' }]
        metricCategories: []
      }
    ]
    enableTelemetry: false
  }
}

// When the app exists, keep its current image (azd sets portalExists).
resource existingPortal 'Microsoft.App/containerApps@2025-01-01' existing = if (portalExists) {
  name: 'ca-portal-${suffix}'
}

module portal 'br/public:avm/res/app/container-app:0.23.0' = {
  name: 'portal'
  params: {
    name: 'ca-portal-${suffix}'
    location: location
    tags: union(tags, { 'azd-service-name': 'portal' })
    environmentResourceId: containerEnv.outputs.resourceId
    managedIdentities: {
      userAssignedResourceIds: [portalIdentity.outputs.resourceId]
    }
    registries: [
      {
        server: registry.outputs.loginServer
        identity: portalIdentity.outputs.resourceId
      }
    ]
    containers: [
      {
        name: 'portal'
        image: portalExists ? existingPortal!.properties.template.containers[0].image : placeholderImage
        resources: {
          cpu: json('0.25')
          memory: '0.5Gi'
        }
      }
    ]
    ingressExternal: true
    ingressTargetPort: 8080          // .NET containers listen on 8080
    ingressAllowInsecure: false      // HTTPS only
    scaleSettings: {
      minReplicas: 0                 // module default is 3: scale to zero when idle
      maxReplicas: 1
    }
    enableTelemetry: false
  }
}

output registryLoginServer string = registry.outputs.loginServer
output registryName string = registry.outputs.name
output portalName string = portal.outputs.name
output portalUri string = 'https://${portal.outputs.fqdn}'
output deployIdentityClientId string = deployIdentity.outputs.clientId
